{
  "name": "mermaid-design",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Split-screen Mermaid live editor with modern UI",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
